{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "studio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--hair",
      "--hair-2",
      "--mark",
      "--ok",
      "--pg",
      "--pg-2",
      "--tx",
      "--tx-2",
      "--tx-3",
      "--u",
      "--warn"
    ],
    "tokenKinds": {
      "--pg": "color",
      "--pg-2": "color",
      "--tx": "color",
      "--tx-2": "color",
      "--tx-3": "color",
      "--hair": "color",
      "--hair-2": "color",
      "--mark": "color",
      "--ok": "color",
      "--warn": "color",
      "--u": "other"
    },
    "fontFamilies": []
  }
}