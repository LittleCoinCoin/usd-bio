#usda 1.0
(
    defaultPrim = "p53_MDM2_complex"
    doc = "Analysis layer (Pipeline 4): MaBoSS node-probability trajectories as time-sampled bio:maboss:prob:<node> under a maboss/ scope per genotype variant. SubLayers the 1YCR topology; base topology untouched. Probabilities are GENUINE MaBoSS simulation output (MaBoSS (external binary, colomoto); MaBoSS version 2.6.6 [networks up to 64 nodes])."
    endTimeCode = 499
    framesPerSecond = 10
    metersPerUnit = 1e-10
    startTimeCode = 0
    subLayers = [
        @../output/p53_mdm2_topology.usda@
    ]
    timeCodesPerSecond = 10
    upAxis = "Y"
)

over "p53_MDM2_complex"
{
    def Scope "maboss"
    {
        custom string bio:maboss:backend = "MaBoSS (external binary, colomoto)"
        custom string bio:maboss:engineVersion = "MaBoSS version 2.6.6 [networks up to 64 nodes]"
