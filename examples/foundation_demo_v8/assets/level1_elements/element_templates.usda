                {
                    float3[] extent = [(-0.18, -0.18, -0.18), (0.18, 0.18, 0.18)]
                    color3f[] primvars:displayColor = [(1, 1, 1)]
                    double radius = 0.18
                }

            }
            "vdw" {
                def Sphere "Sphere"
                {
                    float3[] extent = [(-1.2, -1.2, -1.2), (1.2, 1.2, 1.2)]
                    color3f[] primvars:displayColor = [(1, 1, 1)]
