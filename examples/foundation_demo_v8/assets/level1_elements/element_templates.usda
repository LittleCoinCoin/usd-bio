            }
            "ballstick" {
                def Sphere "Sphere"
                {
                    float3[] extent = [(-0.3, -0.3, -0.3), (0.3, 0.3, 0.3)]
                    color3f[] primvars:displayColor = [(1, 1, 1)]
                    double radius = 0.3
                }

            }
            "points" {
