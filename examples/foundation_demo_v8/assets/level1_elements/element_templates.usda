#usda 1.0
(
    "Element templates with scientific metadata"
    upAxis = "Y"
)

class "_class_"
{
    class "H" (
        prepend variantSets = "representation"
    )
    {
        custom float bio:atomicMass = 1.008
        custom int bio:atomicNumber = 1
        custom float bio:covalentRadius = 0.31
        custom float bio:electronegativity = 2.2
        custom string bio:name = "Hydrogen"
        custom string bio:notes = "Most abundant, hydrogen bonds, proton transfer"
        custom token bio:symbol = "H"
        custom float bio:vdwRadius = 1.2
        variantSet "representation" = {
            "balls" {
                def Sphere "Sphere"
                {
                    float3[] extent = [(-0.36, -0.36, -0.36), (0.36, 0.36, 0.36)]
                    color3f[] primvars:displayColor = [(1, 1, 1)]
                    double radius = 0.36
