#usda 1.0
(
    defaultPrim = "ABLComplex"
    doc = "Dynamics layer: attaches MD trajectory data via UsdClipsAPI. Allows removing trajectory without affecting topology or analysis layers."
    endTimeCode = 19
    framesPerSecond = 10
    metersPerUnit = 1e-10
    startTimeCode = 0
    upAxis = "Y"
)

over "ABLComplex" (
    clips = {
        dictionary default = {
            double2[] active = [(0, 0)]
            asset[] assetPaths = [@../../output/clips/trajectory_clip.usda@]
            string primPath = "/ABLComplex"
            double2[] times = [(0, 0), (19, 19)]
        }
    }
)
{
}

