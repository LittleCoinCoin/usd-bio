#usda 1.0
(
    defaultPrim = "ABLComplex"
    doc = "Protocol layer: ShinobuLab MD simulation setup metadata. Defines /ABLComplex/ProtocolMetadata Xform with simulation parameters."
    metersPerUnit = 1e-10
    upAxis = "Y"
)

def "ABLComplex"
{
    def Xform "ProtocolMetadata"
    {
        custom float3 bio:boxDimensions = (75, 75, 75)
        custom float bio:equilibrationNs = 2.5
        custom int bio:ionCount = 42
        custom token bio:solventModel = "TIP3P"
    }
}

