#usda 1.0
(
    defaultPrim = "ABLComplex"
    endTimeCode = 19
    framesPerSecond = 10
    metersPerUnit = 1e-10
    startTimeCode = 0
    subLayers = [
        @../assets/level6_departmental/review.usda@,
        @../assets/level6_departmental/analysis.usda@,
        @../assets/level6_departmental/dynamics.usda@,
        @../assets/level6_departmental/protocol.usda@,
        @../assets/level6_departmental/biology.usda@
    ]
    upAxis = "Y"
)

over "ABLComplex" (
    variants = {
        string representation = "ballstick"
    }
    prepend variantSets = "representation"
)
{
    variantSet "representation" = {
        "balls" {

        }
        "ballstick" {

        }
        "points" {

        }
        "vdw" {

        }
    }
}

