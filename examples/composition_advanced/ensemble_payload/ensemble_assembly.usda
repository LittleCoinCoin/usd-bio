#usda 1.0
(
    defaultPrim = "ABLEnsemble"
    endTimeCode = 1
    metersPerUnit = 1e-10
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "ABLEnsemble" (
    variants = {
        string ReplicaID = "rep_01"
    }
    prepend variantSets = "ReplicaID"
)
{
    variantSet "ReplicaID" = {
        "rep_01" (
            prepend payload = @clips/rep_01.usda@
        ) {

        }
        "rep_02" (
            prepend payload = @clips/rep_02.usda@
        ) {

        }
        "rep_03" (
            prepend payload = @clips/rep_03.usda@
        ) {

        }
    }
}

